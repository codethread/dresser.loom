{:paths ["src"]
 :aliases
 {:test {:extra-paths ["test" "../millstrand/spools/workflow/src"]
         ;; The published Millstrand core is consumed by immutable SHA. The
         ;; workflow spool is a source root in that same checkout during local
         ;; tests; it is not a published consumer override.
         :extra-deps {io.millstrand/millstrand
                      {:git/url "https://github.com/codethread/millstrand.git"
                       :git/sha "5790c459e9bb692b5e975f9715df7d5b403feff2"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "ct.spools.<name>-test"]}}}
